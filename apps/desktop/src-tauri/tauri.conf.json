{
  "productName": "doxus",
  "version": "0.1.7",
  "identifier": "io.doxus.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "export PATH=\"$HOME/.nvm/versions/node/v20.20.0/bin:$PATH\" && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "doxus",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "sidecar/**/*",
      "../../../crates/plugins/*/*.wasm",
      "../../../crates/plugins/*/*.manifest.toml"
    ],
    "externalBin": [
      "binaries/doxus-mcp"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["doxus"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBRDc5RkE0QzNFNzQyNzAKUldSd1F1ZkRwSi9YR21HOGJSQWRJWXZ4YWcvUG9LY3hkeUp0SEg0Y3lSUXJVdmc2VXRoUTltN3UK",
      "endpoints": [
        "https://github.com/gorillaKim/doxus/releases/latest/download/latest.json"
      ]
    }
  }
}
